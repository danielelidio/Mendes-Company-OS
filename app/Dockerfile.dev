FROM node:22-alpine

WORKDIR /app

# Install dependencies first for better layer caching.
COPY package.json package-lock.json ./
RUN npm install

# App source — overridden by the bind mount in docker-compose for live reload.
COPY . .

EXPOSE 3005

CMD ["npx", "expo", "start", "--web", "--port", "3005", "--host", "lan"]

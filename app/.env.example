# Firebase Web config — from Firebase console → Project settings → Your apps → Web app.
# EXPO_PUBLIC_* vars are inlined into the client bundle (a web config is not secret).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local testing / E2E: use the Firebase Emulator Suite (docker compose up firebase-emulators).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# Ambiente do app: "local" | "development" | "production".
# Ferramentas de dev (ex.: botão "Limpar tudo") aparecem em local e development.
EXPO_PUBLIC_APP_ENV=local
